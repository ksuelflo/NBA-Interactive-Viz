library(tidyverse)
library(haven)
library(mice)
library(WeightedCluster)
set.seed(123)
single_imp <- complete(imputation, 1) %>% standardize()
data <- read_csv("../data/CCES24_Common_OUTPUT_vv_topost_final.csv")
dta_data <- read_dta("../data/CCES24_Common_OUTPUT_vv_topost_final.dta")
codebook_full <- map_dfr(names(dta_data), function(var) {
col <- dta_data[[var]]
q_label <- attr(col, "label") %||% NA_character_
val_labels <- attr(col, "labels")  # named numeric vector
if (!is.null(val_labels)) {
tibble(
variable  = var,
question  = q_label,
value     = val_labels,
value_label = names(val_labels)
)
} else {
tibble(
variable    = var,
question    = q_label,
value       = NA_real_,
value_label = NA_character_
)
}
})
ces_issue_vars <- c(
# Environment/climate
"CC24_326a", "CC24_326b", "CC24_326c", "CC24_326d",
# Guns
"CC24_321a", "CC24_321b", "CC24_321c",
# Immigration
"CC24_323a", "CC24_323b", "CC24_323c", "CC24_323d", "CC24_340f",
# Abortion
"CC24_324a", "CC24_324c",
# LGBT / gender
"CC24_340c", "CC24_444a", "CC24_444b",
# Race
"CC24_440a", "CC24_440b", "CC24_441a", "CC24_441b",
# Government size / welfare
"CC24_328c", "CC24_328d", "CC24_328e", "CC24_443_1",
# Taxes
"CC24_341b", "CC24_341c",
# Foreign policy
"CC24_420_5", "CC24_420_6",
# Political engagement
"newsint",
#Importance of religion, church attendance
"pew_religimp",
"pew_churatd",
#Christian nationality
"pew_bornagain"
)
codebook_full%>%
filter(variable %in% ces_issue_vars)
#Getting only the variables used in the clustering
clustering_vars <- data%>%
select(ces_issue_vars)
#Multiple imputation
imputation <- mice(clustering_vars, m = 1, method = "pmm")
#Standardize variables
standardize <- function(dat){
dat%>%
mutate(across(everything(), ~ (. - mean(., na.rm = TRUE)) / sd(., na.rm = TRUE)))
}
library(cluster)
single_imp <- complete(imputation, 1) %>% standardize()
# CLARA is PAM for large datasets
k_results <- map_dfr(2:12, function(k) {
clara_fit <- clara(
single_imp,
k = k,
metric = "euclidean",
samples = 50,        # number of subsamples
sampsize = 1000,     # size of each subsample (default is 40+2k, but bigger = better)
pamLike = TRUE,      # makes it behave more like PAM
rngR = TRUE,
seed = 123
)
tibble(
k = k,
avg_silhouette = clara_fit$silinfo$avg.width
)
})
k_results <- map_dfr(2:12, function(k) {
clara_fit <- clara(
single_imp,
k = k,
metric = "euclidean",
samples = 50,        # number of subsamples
sampsize = 1000,     # size of each subsample (default is 40+2k, but bigger = better)
pamLike = TRUE,      # makes it behave more like PAM
rngR = TRUE
)
tibble(
k = k,
avg_silhouette = clara_fit$silinfo$avg.width
)
})
ggplot(k_results, aes(x = k, y = avg_silhouette)) +
geom_line() +
geom_point() +
scale_x_continuous(breaks = 2:12) +
labs(
title = "CLARA Clustering: Average Silhouette Width by k",
x = "Number of clusters (k)",
y = "Average silhouette width"
)
