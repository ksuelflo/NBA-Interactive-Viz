else{
lower <- str_extract(value, "(?<=[:symbol:]).*-")
upper <- str_extract_all(value, "(?<=[:space:][:symbol:]).*")
number <- round(as.numeric(str_remove(upper, "[:punct:]")), -4)
return (lower)
}
}
